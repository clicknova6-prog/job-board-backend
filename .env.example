# PostgreSQL connection string used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_board

# Database the API integration tests create, migrate, and freely truncate.
# Optional: defaults to DATABASE_URL with the database name replaced by
# job_board_test. Never point this at the development database.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/job_board_test

# Authentication and Google OAuth. All are required by their respective services.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Celery broker and disposable/debugging-only result backend.
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1

# Shared API rate-limit counters. This DB must differ from the Celery broker DB.
REDIS_RATELIMIT_DB=2

# Per-IP API rate limits. Values use SlowAPI's "count/period" syntax.
RATE_LIMIT_PUBLIC_JOBS=300/minute
RATE_LIMIT_GOOGLE_AUTH=5/minute
RATE_LIMIT_PUBLIC_AUTH_REFRESH=30/minute
RATE_LIMIT_ADMIN_AUTH_LOGIN=5/minute
RATE_LIMIT_ADMIN_AUTH_REFRESH=30/minute
RATE_LIMIT_ADMIN_API=120/minute
RATE_LIMIT_AFFILIATE_REDIRECT=600/minute

# Cached /api/v1/jobs/filters response. This DB must differ from both the
# Celery broker DB and the rate-limit DB. TTL is a safety net only -- the
# import promotion step invalidates the cache directly by bumping its version.
REDIS_FILTERS_CACHE_DB=3
FILTERS_CACHE_TTL_SECONDS=21600

# Sitemap generation and crawler-facing absolute URLs.
PUBLIC_SITE_BASE_URL=http://localhost:3000
SITEMAP_OUTPUT_DIR=storage/sitemaps
SITEMAP_CHUNK_SIZE=50000
SITEMAP_REGEN_INTERVAL_MINUTES=240
