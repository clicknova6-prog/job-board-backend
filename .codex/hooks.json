{
  "description": "Repository formatting, linting, and test hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "repo=\"$(git rev-parse --show-toplevel)\"; \"$repo/.venv/Scripts/python.exe\" \"$repo/.hooks/ruff_post_tool_use.py\" || true",
            "commandWindows": "$repo = git rev-parse --show-toplevel; & \"$repo/.venv/Scripts/python.exe\" \"$repo/.hooks/ruff_post_tool_use.py\"; exit 0",
            "statusMessage": "Running ruff on the edited file...",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo=\"$(git rev-parse --show-toplevel)\"; \"$repo/.venv/Scripts/python.exe\" \"$repo/.codex/hooks/pytest_stop.py\"",
            "commandWindows": "$repo = git rev-parse --show-toplevel; & (Join-Path $repo '.venv\\Scripts\\python.exe') (Join-Path $repo '.codex\\hooks\\pytest_stop.py')",
            "statusMessage": "Running pytest -q...",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
