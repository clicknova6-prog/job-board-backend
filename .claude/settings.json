{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.hooks/ruff_post_tool_use.py\" || true",
            "statusMessage": "Running ruff on the edited file...",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/pytest.exe\" -q \"$CLAUDE_PROJECT_DIR\" 2>&1 ; true",
            "statusMessage": "Running pytest -q...",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
