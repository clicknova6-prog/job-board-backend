# Public entry point: automatic HTTPS (Let's Encrypt) for the API domain.
# Caddy does not trust client-sent X-Forwarded-For by default and sets it to
# the real client IP, which the app uses for rate limiting and audit logs.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	request_body {
		max_size 2MB
	}

	reverse_proxy api:8000 {
		health_uri /health
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}
