# Production settings for compose.prod.yaml. deploy/init-env.sh copies this
# to ./.env and fills every __GENERATE__ value with a random secret.
# Never commit ./.env.

# ---- Public addresses -------------------------------------------------------
# API hostname (DNS A record -> VM public IP). Caddy gets the TLS cert for it.
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
# Hub-wide browser origins (admin panel, etc.). Site frontends are allowed
# automatically from each site's base_url / config.cors_origins.
CORS_ALLOWED_ORIGINS=https://admin.example.com

# ---- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=jobboard
POSTGRES_DB=job_board
POSTGRES_PASSWORD=__GENERATE__
# Must repeat the password above (init-env.sh writes it for you).
DATABASE_URL=postgresql://jobboard:__POSTGRES_PASSWORD__@postgres:5432/job_board

# ---- Redis --------------------------------------------------------------------
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND_URL=redis://redis:6379/1
REDIS_RATELIMIT_DB=2
REDIS_FILTERS_CACHE_DB=3
FILTERS_CACHE_TTL_SECONDS=21600

# ---- Auth ---------------------------------------------------------------------
JWT_SECRET=__GENERATE__
JWT_ALGORITHM=HS256
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/auth/google/callback

# ---- Rate limits ------------------------------------------------------------
RATE_LIMIT_PUBLIC_JOBS=300/minute
RATE_LIMIT_GOOGLE_AUTH=5/minute
RATE_LIMIT_PUBLIC_AUTH_REFRESH=30/minute
RATE_LIMIT_ADMIN_AUTH_LOGIN=5/minute
RATE_LIMIT_ADMIN_AUTH_REFRESH=30/minute
RATE_LIMIT_ADMIN_API=120/minute
RATE_LIMIT_ADMIN_IMPORT_TRIGGER=5/minute

# ---- Sitemaps -----------------------------------------------------------------
SITEMAP_OUTPUT_DIR=/app/storage/sitemaps
SITEMAP_CHUNK_SIZE=50000
SITEMAP_REGEN_INTERVAL_MINUTES=240

# ---- Process sizing (2 OCPU / 12 GB) ------------------------------------------
API_WORKERS=2
WORKER_CONCURRENCY=2

# ---- Backups (deploy/backup.sh) -----------------------------------------------
BACKUP_DIR=/var/backups/job-board
BACKUP_KEEP_DAYS=14
# Optional off-box copy via rclone (e.g. OCI Object Storage). Empty = local only.
RCLONE_REMOTE=
REMOTE_KEEP_DAYS=7
